generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String                @id @default(cuid())
  name              String?
  email             String?               @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String?
  accounts          Account[]
  sessions          Session[]
  bookmarks         Bookmark[]
  interests         Category[]            @relation("UserInterests")
  interactions      UserInteraction[]
  categoryViews     UserCategoryView[]
  sourcePreferences SourcePreference[]
  feedPreference    UserFeedPreference?
  articleFeedback   ArticleFeedback[]
  analyticsEvents   AnalyticsEvent[]
  profileEmbedding  UserProfileEmbedding?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Article {
  id           String                       @id @default(cuid())
  title        String
  source       String
  categoryId   String
  category     Category                     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  summary      String?
  imageUrl     String?
  content      String?
  url          String?                      @unique
  publishedAt  DateTime
  embedding    Unsupported("vector(1536)")?
  bookmarks    Bookmark[]
  interactions UserInteraction[]
  feedback     ArticleFeedback[]
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  @@index([categoryId, publishedAt])
  @@index([publishedAt])
  @@index([source])
}

model UserFeedPreference {
  id                   String       @id @default(cuid())
  userId               String       @unique
  topics               String[]     @default([])
  sources              String[]     @default([])
  location             String       @default("us")
  readingDepth         ReadingDepth @default(BALANCED)
  hideNsfw             Boolean      @default(true)
  politicalSensitivity String       @default("balanced")
  onboardingComplete   Boolean      @default(false)
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model ArticleFeedback {
  id        String                @id @default(cuid())
  userId    String
  articleId String
  reason    ArticleFeedbackReason @default(SHOW_FEWER)
  source    String
  category  String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article               @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime              @default(now())

  @@unique([userId, articleId, reason])
  @@index([userId, source])
  @@index([userId, category])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  path      String?
  payload   Json
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([userId, createdAt])
}

enum ReadingDepth {
  QUICK
  BALANCED
  DEEP
}

enum ArticleFeedbackReason {
  SHOW_FEWER
  SENSITIVE
  LOW_QUALITY
}

model Category {
  id              String             @id @default(cuid())
  name            String             @unique
  slug            String             @unique
  description     String?
  articles        Article[]
  interestedUsers User[]             @relation("UserInterests")
  views           UserCategoryView[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model Bookmark {
  id              String    @id @default(cuid())
  userId          String
  articleId       String
  folder          String    @default("Read later")
  tags            String[]  @default([])
  note            String?
  offlineSnapshot String?
  offlineSavedAt  DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  article         Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, articleId])
  @@index([articleId])
  @@index([userId, folder])
}

model SourcePreference {
  id                String                 @id @default(cuid())
  userId            String
  source            String
  action            SourcePreferenceAction @default(NEUTRAL)
  hideSensational   Boolean                @default(false)
  preferredRegion   String?
  preferredLanguage String?
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([userId, source])
  @@index([userId, action])
}

enum SourcePreferenceAction {
  NEUTRAL
  MUTE
  PRIORITIZE
}

model UserInteraction {
  id                      String    @id @default(cuid())
  userId                  String
  articleId               String
  clickCount              Int       @default(0)
  totalReadingTimeSeconds Int       @default(0)
  lastClickedAt           DateTime?
  lastReadAt              DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  article                 Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([userId, articleId])
  @@index([articleId])
  @@index([userId, updatedAt])
}

model UserCategoryView {
  id           String    @id @default(cuid())
  userId       String
  categoryId   String
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, categoryId])
  @@index([categoryId])
  @@index([userId, updatedAt])
}

model ArticleSummaryCache {
  id               String   @id @default(cuid())
  articleHash      String   @unique
  title            String
  url              String?
  model            String
  threeLineSummary String[]
  explainSimply    String
  keyTakeaways     String[]
  whyThisMatters   String
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([expiresAt])
}

model UserProfileEmbedding {
  id                 String                      @id @default(cuid())
  userId             String                      @unique
  user               User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  embedding          Unsupported("vector(1536)")
  model              String
  sourceArticleCount Int                         @default(0)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
}
